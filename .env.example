# SHOPORA environment template
# Copy to .env.local for local development. NEVER commit real secrets.

# --- Database (PostgreSQL) -------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shopora?schema=public"

# --- Auth (Phase 2) --------------------------------------------------------
# Replace with a long random string: `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
JWT_ACCESS_SECRET="CHANGE_ME_phase2_access_secret"
JWT_REFRESH_SECRET="CHANGE_ME_phase2_refresh_secret"

# --- App -------------------------------------------------------------------
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- File storage (Phase 3 → Phase 11: R2) ----------------------------------
# local  — files under public/uploads/, served statically (dev/MVP, does NOT
#          survive redeploys on ephemeral-persisted hosts — fine for dev).
# r2     — uploads to a Cloudflare R2 bucket via @aws-sdk/client-s3 (prod).
#          Requires R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY,
#          R2_BUCKET and R2_PUBLIC_BASE_URL below.
STORAGE_DRIVER="local"
# UPLOAD_DIR="public/uploads"          # default; set an absolute path if desired

# --- R2 / object storage (Phase 11; only when STORAGE_DRIVER=r2) -------------
# R2_ENDPOINT defaults to https://R2_ACCOUNT_ID.r2.cloudflarestorage.com.
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET="shopora-images"
# R2_PUBLIC_BASE_URL="https://images.yourdomain.com"
#
# Next.js <Image> allow-lists R2_PUBLIC_BASE_URL automatically when set at
# build time (see next.config.js). Uploaded files are served from that URL —
# put Cloudflare's CDN cache in front of the bucket for production speed.

# --- Injection note ----------------------------------------------------------
# Wokers/Injection note (superseded in Phase 11): the original Worker-deploy
# plan was blocked by statelessness (no writable FS). Phase 11 added the R2
# driver, so storage no longer pins the deploy target — but the app still runs
# on a normal Node host (argon2 native binding + node:crypto), see DEPLOYMENT.md.

# --- Inventory thresholds (Phase 5) ----------------------------------------
LOW_STOCK_THRESHOLD=5

# --- Payments: secret-key encryption at rest (Phase 8) ----------------------
# Master key guarding each business's connected provider secret (AES-256-GCM,
# src/lib/payments/secret.ts). REQUIRED in production — startup throws without
# it. Dev fallback exists only when NODE_ENV != production.
# Generate: openssl rand -hex 32
KEY_ENCRYPTION_SECRET="CHANGE_ME_phase8_key_encryption_secret"

# --- Payments: SHOPORA subscription billing (Phase 9) ----------------------
# SHOPORA's OWN Paystack account collects platform subscription payments.
# (Store owners bring their own connected key for storefront checkout.)
# Test key format: sk_test_...
PAYSTACK_SECRET_KEY="sk_test_your_platform_secret_key"

# --- Payments: native subscriptions (Phase 11) ------------------------------
# Public key used by the Paystack hosted checkout; never used server-side.
PAYSTACK_PUBLIC_KEY="pk_test_your_public_key"
# Optional fallback when you rotate a dedicated webhook secret on Paystack's
# dashboard. When empty, webhooks are verified with PAYSTACK_SECRET_KEY (which
# is what Paystack signs with by default).
PAYSTACK_WEBHOOK_SECRET=""

# --- Billing cron (Phase 11) ------------------------------------------------
# Guards GET /api/cron/billing?token=... — the daily soft-downgrade sweep.
# Generate with: openssl rand -hex 32
CRON_TOKEN="CHANGE_ME_phase11_cron_token"