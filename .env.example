# SHOPORA environment template
# Copy to .env.local for local development. NEVER commit real secrets.

# --- Database (PostgreSQL) -------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shopora?schema=public"

# --- Auth (Phase 2) --------------------------------------------------------
# Replace with a long random string: `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
JWT_ACCESS_SECRET="CHANGE_ME_phase2_access_secret"
JWT_REFRESH_SECRET="CHANGE_ME_phase2_refresh_secret"

# --- App -------------------------------------------------------------------
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- File storage (Phase 3) -------------------------------------------------
# Currently LOCAL only. Files are written under public/uploads/ and served
# statically. Object storage (S3 / Cloudflare R2) is NOT configured yet.
STORAGE_DRIVER="local"
# UPLOAD_DIR="public/uploads"          # default; set an absolute path if desired

# --- Subscription limits (Phase 5 stub — Phase 9 TODO) --------------------
# Hardcoded fallback until Subscription/SubscriptionPlan tables land in Phase 9.
# PRODUCT_LIMIT=50

# --- Inventory thresholds (Phase 5) ----------------------------------------
LOW_STOCK_THRESHOLD=5
# CLOUDFLARE_ACCOUNT_ID=""
# CLOUDFLARE_API_TOKEN=""
# CLOUDFLARE_PROJECT_NAME="shopora"
#
# ⚠️  Workers are STATELESS — no writable filesystem. The current
# STORAGE_DRIVER=local (public/uploads/) will NOT persist on Workers.
# Before deploying to Workers, switch to S3 or R2 and implement the matching
# upload/read methods in src/lib/storage.ts.