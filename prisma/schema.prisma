// SHOPORA database schema
// Phase 1+2: foundation tables + auth fields

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Users — account owners across the platform. A user may belong to many
// businesses via BusinessStaff.
// ---------------------------------------------------------------------------
model User {
  id                       String    @id @default(cuid())
  email                    String    @unique
  phone                    String?   @unique
  passwordHash             String
  firstName                String
  lastName                 String
  avatarUrl                String?
  isActive                 Boolean   @default(true)
  lastLoginAt              DateTime?
  passwordResetTokenHash   String?
  passwordResetTokenExpiry DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  staffRoles BusinessStaff[]
  carts      Cart[]
  orders     Order[]

  // Phase 10 platform membership + audit trails
  platformStaff       PlatformStaff[]
  auditLogs           AuditLog[]
  supportTickets      SupportTicket[]
  assignedTickets     SupportTicket[]  @relation("TicketAssignee")
  coupons             Coupon[]
  platformSettingEdits PlatformSetting[]

  @@index([email])
  @@index([phone])
}

// ---------------------------------------------------------------------------
// Businesses — tenants. Every tenant-scoped row traces back to a Business.
// themeConfig stores per-business theme overrides (e.g. wine red accent,
// primary/secondary colours) as JSON. Default theme lives in code; any key
// present here overrides it.
//
// Phase 3: onboarding fields (category, contact, address, branding, banner,
// onboardingStep) power the guided business-onboarding wizard. onboardingStep
// tracks progress and lets a user leave + resume; 2=info, 3=store URL/slug,
// 4=branding. When the wizard finishes, the business is considered complete
// (see helper in tenant lib) and redirected to /dashboard.
// ---------------------------------------------------------------------------
model Business {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  description      String?
  category         String?
  phone            String?
  whatsappNumber   String?
  address          String?
  state            String?
  country          String?
  logoUrl          String?
  bannerUrl        String?
  themeConfig      Json     @default("{}")
  onboardingStep   Int      @default(2)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  deliveryConfig  Json @default("{}")

  staff          BusinessStaff[]
  categories     Category[]
  products       Product[]
  inventory      InventoryTransaction[]
  carts          Cart[]
  orders         Order[]
  paymentProviders PaymentProvider[]
  transactions   Transaction[]
  subscription   Subscription?
  auditLogs      AuditLog[]
  supportTickets SupportTicket[]

  @@index([slug])
  @@index([isActive])
}

// ---------------------------------------------------------------------------
// BusinessStaff — join table tying a User to a Business with a Role.
// Uniqueness is on (userId, businessId, roleId) so one user can hold multiple
// roles within the same business.
// ---------------------------------------------------------------------------
model BusinessStaff {
  id         String   @id @default(cuid())
  userId     String
  businessId String
  roleId     String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  role     Role     @relation(fields: [roleId], references: [id])

  @@unique([userId, businessId, roleId])
  @@index([businessId])
  @@index([roleId])
}

// ---------------------------------------------------------------------------
// Roles — named bundles of permissions. isSystem roles cannot be deleted.
// Global platform roles (no businessId); seed creates Owner + Staff.
// ---------------------------------------------------------------------------
model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  staff       BusinessStaff[]
  platformStaff PlatformStaff[]
  permissions RolePermission[]

  @@index([name])
}

// ---------------------------------------------------------------------------
// Permissions — atomic capabilities, grouped by category for UI organisation.
// e.g. category: "products", name: "products.create"
// ---------------------------------------------------------------------------
model Permission {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  category    String
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@index([category])
}

// ---------------------------------------------------------------------------
// RolePermission — many-to-many join between roles and permissions.
// ---------------------------------------------------------------------------
model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

// ---------------------------------------------------------------------------
// Categories — business-scoped, optionally nested via parentId. Products point
// at a category; deleting a category sets products' categoryId to null.
// Phase 5.
// ---------------------------------------------------------------------------
model Category {
  id          String    @id @default(cuid())
  businessId  String
  name        String
  slug        String
  description String?
  parentId    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  business Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  parent   Category?          @relation("CategoryChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[]         @relation("CategoryChildren")
  products Product[]

  @@unique([businessId, slug])
  @@index([businessId])
  @@index([parentId])
}

// ---------------------------------------------------------------------------
// Products — the catalog item. Always business-scoped; every query must filter
// by the verified session's businessId (never client input).
//
// status: draft | active | archived. stockQuantity is the base stock for
// products WITHOUT variants; products WITH variants track stock per-variant
// (their effective stock is the sum of variant stock).
//
// ⚠️ SUBSCRIPTION LIMIT: product_limit is enforced server-side on create
// against the business's plan (SubscriptionPlan.productLimit). See POST
// /api/products and src/lib/subscriptions/*.
// ---------------------------------------------------------------------------
model Product {
  id             String   @id @default(cuid())
  businessId     String
  categoryId     String?
  name           String
  slug           String
  description    String?
  brand          String?
  sku            String?
  price          Decimal  @db.Decimal(10, 2)
  discountPrice  Decimal? @db.Decimal(10, 2)
  status         String   @default("draft")
  stockQuantity  Int      @default(0)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  business  Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category  Category?              @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images    ProductImage[]
  variants  ProductVariant[]
  inventory InventoryTransaction[]
  cartItems CartItem[]
  orderItems OrderItem[]

  @@unique([businessId, slug])
  @@index([businessId])
  @@index([categoryId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// ProductImage — ordered gallery images for a product. Local-disk urls this
// phase (see src/lib/storage.ts); positions power thumbnail ordering.
// ---------------------------------------------------------------------------
model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// ---------------------------------------------------------------------------
// ProductVariant — attributes + independent stock for a product.
// priceOverride overrides Product.price; weight in grams (or store-specific
// unit). Stock lives here for variant products.
// ---------------------------------------------------------------------------
model ProductVariant {
  id            String   @id @default(cuid())
  productId     String
  sku           String?
  color         String?
  size          String?
  weight        Decimal? @db.Decimal(10, 2)
  priceOverride Decimal? @db.Decimal(10, 2)
  stockQuantity Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product   Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory InventoryTransaction[]
  cartItems CartItem[]
  orderItems OrderItem[]

  @@index([productId])
}

// ---------------------------------------------------------------------------
// Cart — guest/session cart scoped to a business. Identified by
// (businessId, sessionId) where sessionId comes from the shopora_cart_session
// cookie. userId is optional reference for logged-in customers.
// ---------------------------------------------------------------------------
model Cart {
  id         String   @id @default(cuid())
  businessId String
  sessionId  String
  userId     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  items    CartItem[]

  @@unique([businessId, sessionId])
  @@index([businessId])
  @@index([sessionId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// CartItem — line item in a cart. Quantity is user-editable. Price is
// snapshotted from the product/variant at checkout time, not here.
// ---------------------------------------------------------------------------
model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  variantId String?
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([cartId])
  @@index([productId])
}

// ---------------------------------------------------------------------------
// Order — a placed order. status flows: payment_pending → paid → confirmed →
// processing → shipped/delivered → cancelled. Totals are snapshotted.
// paymentMethod records how the customer chose to pay (paystack | bank_transfer
// | cash_on_delivery); paidAt is set once payment is received (gateway webhook
// or manual dashboard confirmation).
// ---------------------------------------------------------------------------
model Order {
  id              String    @id @default(cuid())
  businessId      String
  userId          String?
  orderNumber     String    @default("")
  status          String    @default("payment_pending")
  paymentMethod   String    @default("bank_transfer")
  paidAt          DateTime?
  customerName    String
  customerEmail   String
  customerPhone   String?
  deliveryMethod  String    @default("standard")
  deliveryAddress Json?
  subtotal        Decimal   @db.Decimal(12, 2)
  discountTotal   Decimal   @db.Decimal(12, 2) @default(0)
  deliveryFee     Decimal   @db.Decimal(12, 2) @default(0)
  total           Decimal   @db.Decimal(12, 2)
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  business    Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user        User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  items       OrderItem[]
  history     OrderStatusHistory[]
  transactions Transaction[]

  @@index([businessId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// OrderItem — price snapshot per line at order time. productName/variantLabel
// survive future product edits.
// ---------------------------------------------------------------------------
model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  productId    String
  variantId    String?
  productName  String
  variantLabel String?
  quantity     Int
  unitPrice    Decimal  @db.Decimal(12, 2)
  total        Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now())

  order   Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant ProductVariant?  @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

// ---------------------------------------------------------------------------
// OrderStatusHistory — immutable audit trail of status transitions.
// ---------------------------------------------------------------------------
model OrderStatusHistory {
  id        String   @id @default(cuid())
  orderId   String
  status    String
  note      String?
  changedAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// ---------------------------------------------------------------------------
// PaymentProvider — a gateway connection a business owns (per-business account,
// e.g. Paystack). status: connected | disconnected. publicKey is safe to show;
// the SECRET KEY is NEVER stored here — it lives encrypted in the
// PaymentProviderSecret table and is only ever decrypted server-side.
// provider: 'paystack' (Flutterwave arrives in a later phase).
// ---------------------------------------------------------------------------
model PaymentProvider {
  id          String    @id @default(cuid())
  businessId  String
  provider    String
  publicKey   String?
  status      String    @default("disconnected")
  connectedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  business Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  secret   PaymentProviderSecret?

  @@unique([businessId, provider])
  @@index([businessId])
}

// ---------------------------------------------------------------------------
// PaymentProviderSecret — encrypted-at-rest secret key for a PaymentProvider.
// AES-256-GCM with a master key from the KEY_ENCRYPTION_SECRET env var (see
// src/lib/payments/secret.ts). Write-only from the dashboard's perspective:
// nothing in the app ever decrypts and returns this value to a client.
// ---------------------------------------------------------------------------
model PaymentProviderSecret {
  id         String   @id @default(cuid())
  providerId String   @unique
  encrypted  String
  keyVersion String   @default("v1")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  provider PaymentProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Transaction — a payment lifecycle record. One row per gateway attempt,
// anchored by (provider, providerRef) so replayed webhooks can't double-process.
// status: initiated → success | failed | pending. providerRef is the gateway
// reference (Paystack `reference`); manual confirmations use provider 'manual'
// and a NULL providerRef.
// ---------------------------------------------------------------------------
model Transaction {
  id          String    @id @default(cuid())
  businessId  String
  orderId     String?
  provider    String
  providerRef String?
  amount      Decimal   @db.Decimal(12, 2)
  status      String    @default("initiated")
  type        String    @default("payment")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  order    Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([provider, providerRef])
  @@index([businessId])
  @@index([orderId])
  @@index([providerRef])
}

// ---------------------------------------------------------------------------
// InventoryTransaction — the audit trail for every stock change. NO code path
// may mutate stockQuantity outside writing a row here first (or in the same
// transaction). changeQty is signed: +n = received/added, -n = sold/adjusted.
// ---------------------------------------------------------------------------
model InventoryTransaction {
  id          String    @id @default(cuid())
  businessId  String
  productId   String
  variantId   String?
  changeQty   Int
  reason      String
  createdById String?
  createdAt   DateTime  @default(now())

  business Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product  Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant  ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([productId])
  @@index([variantId])
}

// ---------------------------------------------------------------------------
// SubscriptionPlan — the tier catalogue (Phase 9). Seeded by db:seed-plans.
// productLimit/staffLimit gate create/invite; customDomain + analyticsTier flip
// features in later phases. Prices are the store's billable NGN amounts.
// ---------------------------------------------------------------------------
model SubscriptionPlan {
  id                 String   @id @default(cuid())
  name               String   @unique // 'starter' | 'business' | 'premium'
  displayName        String
  description        String?
  monthlyPriceNaira  Decimal  @db.Decimal(12, 2)
  annualPriceNaira   Decimal  @db.Decimal(12, 2)
  productLimit       Int      @default(50)
  staffLimit         Int      @default(2)
  customDomain       Boolean  @default(false)
  analyticsTier      String   @default("basic") // basic | advanced
  isActive           Boolean  @default(true)
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  subscriptions Subscription[]

  @@index([isActive])
}

// ---------------------------------------------------------------------------
// Subscription — a business's live plan + billing state (Phase 9).
//   trial     → free Starter trial (14d). expires into past_due.
//   active    → paid. expires (period end) into past_due.
//   past_due  → grace (7d). store stays live; checkout allowed. → suspended.
//   suspended → checkout blocked; storefront stays viewable. → cancelled.
//   cancelled → storefront 404; dashboard read-only except Subscription page.
// currentPeriodEnd doubles as the rolling deadline for the CURRENT status
// (trial end, paid period end, grace end, or suspension end).
// ---------------------------------------------------------------------------
model Subscription {
  id                       String   @id @default(cuid())
  businessId               String   @unique
  planId                   String
  billingCycle             String   @default("monthly") // monthly | annual
  status                   String   @default("trial")   // trial|active|past_due|suspended|cancelled
  trialEndsAt              DateTime?
  currentPeriodEnd         DateTime
  cancelledAt              DateTime?
  paystackCustomerCode     String?
  paystackAuthorizationCode String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plan     SubscriptionPlan @relation(fields: [planId], references: [id])
  history  SubscriptionHistory[]

  @@index([status])
  @@index([planId])
}

// ---------------------------------------------------------------------------
// SubscriptionHistory — immutable audit trail for every plan/status change.
// ---------------------------------------------------------------------------
model SubscriptionHistory {
  id             String   @id @default(cuid())
  subscriptionId String
  fromStatus     String?
  toStatus       String
  note           String?
  changedAt      DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
}

// ---------------------------------------------------------------------------
// PlatformStaff — GLOBAL platform-admin membership (Phase 10). Reuses the
// global Role/Permission tables from Phase 2 — a platform admin is a User with
// an active row here pointing at a platform role (e.g. 'Platform Super Admin'
// or 'Platform Admin'). This is what gates the /admin route group; there is no
// self-registration path for it (bootstrap via prisma/seed-admin.ts).
// ---------------------------------------------------------------------------
model PlatformStaff {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@index([roleId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// AuditLog — immutable platform audit trail (Phase 10). Written for every
// privileged action (impersonation start/end, business suspend/reactivate,
// plan changes, admin account changes). actorUserId is null for system/
// webhook-driven events; businessId ties an entry to a tenant when relevant.
// This MUST exist before impersonation ships — every impersonation start/end
// writes a row here.
// ---------------------------------------------------------------------------
model AuditLog {
  id           String   @id @default(cuid())
  actorUserId  String?
  businessId   String?
  action       String   // e.g. 'impersonate.start' | 'business.suspend' | 'plan.update'
  target       String?  // human-meaningful subject: business slug, plan name, admin email
  metadataJson Json?
  createdAt    DateTime @default(now())

  actor    User?     @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action])
}

// ---------------------------------------------------------------------------
// SupportTicket — platform support inbox (Phase 10). Minimal: a reporter
// (business or user, both optional — guests can file), subject/body, workflow
// state, and an optional platform-staff assignee.
// ---------------------------------------------------------------------------
model SupportTicket {
  id             String   @id @default(cuid())
  businessId     String?
  userId         String?
  subject        String
  body           String
  status         String   @default("open")      // open | in_progress | resolved | closed
  priority       String   @default("normal")    // low | normal | high | urgent
  assigneeUserId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  business Business?   @relation(fields: [businessId], references: [id], onDelete: SetNull)
  user     User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  assignee User?       @relation("TicketAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([priority])
  @@index([businessId])
}

// ---------------------------------------------------------------------------
// Coupon — platform-wide discount codes (Phase 10). kind percentage|fixed;
// value is the % (e.g. 10 = 10%) or fixed naira. Optional min-order floor,
// usage cap, and validity window.
// ---------------------------------------------------------------------------
model Coupon {
  id             String   @id @default(cuid())
  code           String   @unique
  kind           String   @default("percentage") // percentage | fixed
  value          Decimal  @db.Decimal(12, 2)
  minOrderAmount Decimal? @db.Decimal(12, 2)
  maxUses        Int?
  usedCount      Int      @default(0)
  startsAt       DateTime?
  expiresAt      DateTime?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  createdById    String?

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([code])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// PlatformSetting — platform-wide key/value config (Phase 10). value is JSON
// (scalars, flags, nested config). Editable only via the /admin settings page.
// ---------------------------------------------------------------------------
model PlatformSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([key])
}